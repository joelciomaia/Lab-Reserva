# Client OAuth 2.0 do tipo "Aplicativo da Web", configurado centralmente
# por ambiente. O mesmo Client ID atende todas as escolas que usam esta origem.
#
# No projeto Google Cloud:
# - habilite Google Sheets API e Google Drive API;
# - use audiência External e publique como In production para liberar novos usuários;
# - cadastre a origem exata do frontend (localhost no desenvolvimento e HTTPS em produção).
#
# O Client ID é público; não coloque Client Secret, access token ou dados de
# qualquer escola neste arquivo.
VITE_GOOGLE_CLIENT_ID=000000000000-exemplo.apps.googleusercontent.com

# Web App publicado a partir da pasta apps-script/. Ele executa como o
# proprietário e é o único caminho usado pela agenda pública para ler/gravar
# reservas na planilha, sem expor token ou spreadsheetId aos professores.
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# E-mail da conta institucional que publicou o Web App acima. O frontend compara
# esse valor com serviceInfo antes de compartilhar qualquer planilha.
VITE_GOOGLE_APPS_SCRIPT_ACCOUNT_EMAIL=agenda.backend@sed.sc.gov.br

# URL HTTPS estável exibida no link e no QR Code dos laboratórios.
# No desenvolvimento, pode ficar ausente para usar a origem atual do navegador.
VITE_PUBLIC_APP_URL=https://agenda.exemplo.org/
